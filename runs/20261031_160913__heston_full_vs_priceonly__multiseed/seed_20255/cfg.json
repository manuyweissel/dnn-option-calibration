{
  "experiment_id": "heston_full_vs_priceonly",
  "seed": 20255,
  "model": {
    "name": "Heston",
    "params": {
      "S0": 1.0,
      "r": 0.02,
      "kappa": 2.0,
      "theta": 0.04,
      "xi": 0.5,
      "rho": -0.5,
      "v0": 0.04
    },
    "sweep": null
  },
  "grid": {
    "K": 50,
    "T": 20,
    "spacing": "logm",
    "K_min": 0.8,
    "K_max": 1.2,
    "T_min": 0.1,
    "T_max": null
  },
  "noise": {
    "price_rel": 0.0,
    "greek_rel": 0.0,
    "seed": null
  },
  "net": {
    "L": 4,
    "W": 64,
    "activation": "softplus",
    "head": "single"
  },
  "loss": {
    "lambda_price": 1.0,
    "lambda_greeks": 1.0,
    "lambda_pde": 0.0,
    "lambda_bc": 1.0,
    "lambda_noarb": 0.0,
    "curriculum": [
      "price",
      "price+greeks"
    ]
  },
  "optim": {
    "name": "adamw",
    "lr": 0.001,
    "weight_decay": 0.0001,
    "schedule": "cosine",
    "epochs": 2000,
    "batch_data": 256,
    "batch_collocation": 1000,
    "amp": false,
    "grad_clip": 1.0,
    "early_stop_patience": 200
  },
  "eval": {
    "metrics": [
      "rmse_price",
      "mae_greeks",
      "param_rel_err",
      "rmse_extrap"
    ],
    "test_grid": "both"
  },
  "ablation_tag": null
}